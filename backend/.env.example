# === Database ===
DATABASE_URL=sqlite:///./genlayer_bot.db

# === Security ===
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_SECRET=replace_with_a_long_random_secret

# === AI ===
GROQ_API_KEY=your_groq_api_key_here

# === GenLayer Network Configuration ===
GENLAYER_RPC_URL_STUDIONET=studio.genlayer.com/api
GENLAYER_RPC_URL_BRADBURY=rpc-bradbury.genlayer.com
GENLAYER_CHAIN_ID_STUDIONET=61999
GENLAYER_CHAIN_ID_BRADBURY=4221
GENLAYER_CONSENSUS_CONTRACT_ADDRESS=

# === Admin Wallet Configuration ===
ADMIN_PRIVATE_KEY=your_admin_private_key_here
ADMIN_WALLET_ADDRESS=your_admin_wallet_address_here
MAX_TRANSFER_AMOUNT=1000
SUPPORTED_TOKENS=GEN

# === CORS ===
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# === Optional Redis Logs ===
REDIS_URL=

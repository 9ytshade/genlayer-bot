# === Database ===
# Local development:
DATABASE_URL=sqlite:///./genlayer_bot.db
# Production on Supabase Postgres:
# DATABASE_URL=postgresql://postgres.project_ref:password@host:5432/postgres?sslmode=require

# === Security ===
APP_ENV=development
# Local-only escape hatch for the isolated Phase 9 Studionet proof page.
# Keep disabled outside a supervised proof run.
GENLAYER_PHASE9_LIVE_PROOF=0
JWT_SECRET=replace_with_at_least_32_random_characters
SIWE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
# Optional comma-separated allowlist. Leave empty to accept the chain signed into the SIWE message.
SIWE_CHAIN_IDS=

# === AI ===
GROQ_API_KEY=your_groq_api_key_here

# === GenLayer Network Configuration ===
GENLAYER_RPC_URL_STUDIONET=https://studio.genlayer.com/api
GENLAYER_RPC_URL_BRADBURY=https://rpc-bradbury.genlayer.com
GENLAYER_CHAIN_ID_STUDIONET=61999
GENLAYER_CHAIN_ID_BRADBURY=4221
RPC_REQUEST_TIMEOUT_SEC=15
RPC_MAX_ATTEMPTS=3
RPC_RETRY_BACKOFF_SEC=0.25
RPC_READINESS_TIMEOUT_SEC=5
# Development-only opt-in. Production readiness always verifies connectivity and chain identity.
CHECK_RPC_READINESS=false
GENLAYER_CONSENSUS_CONTRACT_ADDRESS=
# Optional override. The pinned genlayer-py chain config supplies this by default.
GENLAYER_APPEALS_CONTRACT_ADDRESS=
# Optional per-network appeal protocol overrides (required when the SDK chain config omits them).
GENLAYER_APPEALS_CONTRACT_ADDRESS_STUDIONET=
GENLAYER_APPEALS_CONTRACT_ADDRESS_BRADBURY=
GENLAYER_APPEALS_CONTRACT_ADDRESS_LOCALNET=
GENLAYER_ROUNDS_STORAGE_CONTRACT_ADDRESS=
GENLAYER_ROUNDS_STORAGE_CONTRACT_ADDRESS_STUDIONET=
GENLAYER_ROUNDS_STORAGE_CONTRACT_ADDRESS_BRADBURY=
GENLAYER_ROUNDS_STORAGE_CONTRACT_ADDRESS_LOCALNET=
GENLAYER_FEE_MANAGER_CONTRACT_ADDRESS=
GENLAYER_FEE_MANAGER_CONTRACT_ADDRESS_STUDIONET=
GENLAYER_FEE_MANAGER_CONTRACT_ADDRESS_BRADBURY=
GENLAYER_FEE_MANAGER_CONTRACT_ADDRESS_LOCALNET=

MAX_TRANSFER_AMOUNT=1000
SUPPORTED_TOKENS=GEN

# === CORS ===
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com

# === Optional Redis Logs ===
REDIS_URL=
# Set true in multi-instance production deployments to make missing Redis fail readiness.
REQUIRE_REDIS=false
ACTIVITY_LOG_MAX_ITEMS=300
